DATABASE_URL=postgresql://agenda:agenda_local@127.0.0.1:55432/agenda
JWT_SECRET=
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
HOST=127.0.0.1
PORT=4100
# Produção: NODE_ENV=production, APP_ORIGINS=https://seu-dominio, cookie Secure automático.
# Defina TRUST_PROXY_HOPS somente atrás de proxies de confiança, com o número exato de saltos.
TRUST_PROXY_HOPS=0
MEDIA_DRIVER=local
MEDIA_DIR=.media
# Para S3, configure MEDIA_DRIVER=s3, S3_BUCKET e S3_REGION. Use a cadeia padrão de credenciais AWS.
# S3_ENDPOINT é opcional para armazenamento compatível com S3.
